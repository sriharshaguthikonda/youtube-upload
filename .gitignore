# ---------------------------------------------------------------------------
# Secrets and per-user state. NEVER commit these (see SECURITY.md).
# tests/test_repo_hygiene.py fails if any of these become tracked.
# ---------------------------------------------------------------------------
# Google OAuth client secrets (both the project's name and Google's download
# name "client_secret_<id>.apps.googleusercontent.com.json").
client_secret*.json
client_secrets*.json
# Stored user tokens / credentials, wherever they are.
*credentials*.json
*.credentials
token*.json
*.token.json
.youtube-upload-*
.youtube_upload_*
# Per-account folders used by --accounts-dir / the GUI and their contents.
accounts/
.youtube-upload-accounts/
*_account/
*_accounts/
# GUI settings contain local paths and account names.
gui_settings.json
*.gui_settings.json
# Upload ledger, resumable-session state and debug logs.
.youtube-upload/
youtube_upload_debug.log
# Generic key material and env files.
.env
.env.*
*.pem
*.p12
*.pfx
*.key

# The one allowed (placeholder-only) example.
!examples/client_secrets.example.json

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer / test / coverage output
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.coverage
.coverage.*
.cache
.pytest_cache/
nosetests.xml
coverage.xml
*,cover
.hypothesis/
.ruff_cache/
.mypy_cache/

# Misc
*.mo
*.pot
*.log
docs/_build/
target/

# Editor workspace files
*.code-workspace
.vscode/
.idea/
